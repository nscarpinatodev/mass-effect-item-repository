    {
      "name": "me-weapons",
      "label": "Mass Effect Weapons",
      "path": "packs/me-weapons.db",
      "type": "Item",
      "system": "pf2e"
    },
    {
      "name": "me-weapon-mods",
      "label": "Mass Effect Weapon Mods",
