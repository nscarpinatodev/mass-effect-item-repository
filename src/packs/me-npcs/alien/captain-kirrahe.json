  "system": {
    "slug": "captain-kirrahe",
    "details": {
      "level": { "value": 6 },
      "publicNotes": "<p>Captain Kirrahe of the Salarian Special Tasks Group is a decorated operative who volunteers his team for the near-suicidal mission to destroy Saren's genophage research on Virmire. He leads from the front and demands the same of his soldiers. His briefings are legendary for their relentless focus on holding the line.</p><p><strong>STG Training:</strong> Kirrahe gains a +2 circumstance bonus to initiative rolls and is never caught flat-footed in a surprise round.</p><p><strong>Hold the Line (1 action, 1/encounter):</strong> Kirrahe rallies his allies. All allied creatures within 60 feet who can hear him gain a +2 morale bonus to saves until the start of Kirrahe's next turn.</p>",
      "privateNotes": "",
      "publication": { "title": "Mass Effect Compendium", "authors": "nscarpinatodev", "license": "ORC", "remaster": true },
      "languages": { "value": [], "details": "" },
      "blurb": "Salarian STG captain; tactician and leader who holds the line when everyone else would retreat."
