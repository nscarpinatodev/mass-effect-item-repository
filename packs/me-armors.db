{"folder":null,"name":"Explorer Armor (H)","type":"armor","effects":[],"img":"https://static.wikia.nocookie.net/masseffect/images/a/ad/Heavy-human-Explorer.png","flags":{},"ownership":{"default":0},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.12.2","lastModifiedBy":null},"system":{"description":{"gm":"","value":"<p>Devlon Industries built the Explorer series for survey teams operating in hazardous planetary environments. Internal atmospheric seals and radiation dampeners reduce barrier efficiency compared to combat-focused designs, but the suit allows operations in environments that would otherwise be deadly.</p>"},"rules":[],"slug":"explorer-armor-h","_migration":{"version":0.955,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["bulwark","tech"],"rarity":"common"},"publication":{"title":"Mass Effect Homebrew","authors":"","license":"OGL","remaster":false},"level":{"value":0},"quantity":1,"baseItem":"explorer-armor","bulk":{"value":2},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":40}},"equipped":{"carryType":"worn","invested":null},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"Unusual Armor","img":"systems/pf2e/icons/unidentified_item_icons/armor.webp","data":{"description":{"value":""}}},"misidentified":{}},"category":"heavy","group":"plate","acBonus":3,"strength":3,"dexCap":1,"checkPenalty":-3,"speedPenalty":-10,"grade":"commercial","runes":{"potency":0,"resilient":0,"property":[]},"subitems":[],"specific":null},"_id":"fcd15e261bc9c908"}
