{"folder":null,"name":"Gladiator Armor (H)","type":"armor","effects":[],"img":"https://static.wikia.nocookie.net/masseffect/images/5/54/Heavy-human-Gladiator.png","flags":{},"ownership":{"default":0},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.12.2","lastModifiedBy":null},"system":{"description":{"gm":"","value":"<p>Elkoss Combine's Gladiator line uses mass-produced polymer composites to keep costs low. While barrier output and impact absorption fall short of premium competitors, the armor offers reliable protection for mercenaries and contractors operating on tight budgets.</p>"},"rules":[],"slug":"gladiator-armor-h","_migration":{"version":0.955,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["bulwark","tech"],"rarity":"common"},"publication":{"title":"Mass Effect Homebrew","authors":"","license":"OGL","remaster":false},"level":{"value":0},"quantity":1,"baseItem":"gladiator-armor","bulk":{"value":2},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":40}},"equipped":{"carryType":"worn","invested":null},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"Unusual Armor","img":"systems/pf2e/icons/unidentified_item_icons/armor.webp","data":{"description":{"value":""}}},"misidentified":{}},"category":"heavy","group":"plate","acBonus":3,"strength":3,"dexCap":1,"checkPenalty":-3,"speedPenalty":-10,"grade":"commercial","runes":{"potency":0,"resilient":0,"property":[]},"subitems":[],"specific":null},"_id":"574641983a502ae5"}
