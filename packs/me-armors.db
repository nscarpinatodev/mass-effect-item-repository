{"folder":null,"name":"Predator H Armor","type":"armor","effects":[],"img":"https://static.wikia.nocookie.net/masseffect/images/8/8a/Heavy-human-Predator_H.png","flags":{},"ownership":{"default":0},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.12.2","lastModifiedBy":null},"system":{"description":{"gm":"","value":"<p>Armax Arsenal's Predator H is the definitive heavy hardsuit of its era. Dual-layer ceramic ablative plating, woven durasteel underlining, and Armax's proprietary shield amplification system combine to produce one of the best-protected suits available to any Alliance operative.</p>"},"rules":[],"slug":"predator-h-armor","_migration":{"version":0.955,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["bulwark","tech"],"rarity":"rare"},"publication":{"title":"Mass Effect Homebrew","authors":"","license":"OGL","remaster":false},"level":{"value":5},"quantity":1,"baseItem":"predator-h-armor","bulk":{"value":3},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":600}},"equipped":{"carryType":"worn","invested":null},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"Unusual Armor","img":"systems/pf2e/icons/unidentified_item_icons/armor.webp","data":{"description":{"value":""}}},"misidentified":{}},"category":"heavy","group":"plate","acBonus":6,"strength":4,"dexCap":1,"checkPenalty":-2,"speedPenalty":-5,"grade":"superior","runes":{"potency":0,"resilient":0,"property":[]},"subitems":[],"specific":null},"_id":"97cabaca9a77a75c"}
{"folder":null,"name":"Predator L Armor","type":"armor","effects":[],"img":"https://static.wikia.nocookie.net/masseffect/images/6/6b/Light-human-Predator_L.png","flags":{},"ownership":{"default":0},"_stats":{"compendiumSource":null,"duplicateSource":null,"exportSource":null,"coreVersion":"13.351","systemId":"pf2e","systemVersion":"7.12.2","lastModifiedBy":null},"system":{"description":{"gm":"","value":"<p>Armax Arsenal's Predator series represents the pinnacle of light armor engineering. Nano-weave armalite and a next-generation barrier emitter array deliver maximum agility without sacrificing protection — the preferred choice of N7 operatives and elite special forces.</p>"},"rules":[],"slug":"predator-l-armor","_migration":{"version":0.955,"lastMigration":null,"previous":null},"traits":{"otherTags":[],"value":["tech"],"rarity":"rare"},"publication":{"title":"Mass Effect Homebrew","authors":"","license":"OGL","remaster":false},"level":{"value":2},"quantity":1,"baseItem":"predator-l-armor","bulk":{"value":1},"hp":{"value":0,"max":0},"hardness":0,"price":{"value":{"gp":120}},"equipped":{"carryType":"worn","invested":null},"containerId":null,"size":"med","material":{"type":null,"grade":null},"identification":{"status":"identified","unidentified":{"name":"Unusual Armor","img":"systems/pf2e/icons/unidentified_item_icons/armor.webp","data":{"description":{"value":""}}},"misidentified":{}},"category":"light","group":"leather","acBonus":4,"strength":1,"dexCap":3,"checkPenalty":-1,"speedPenalty":0,"grade":"tactical","runes":{"potency":0,"resilient":0,"property":[]},"subitems":[],"specific":null},"_id":"51d29656a418d624"}
